# Example environment for local development.
#
# Copy to .env and adjust for your machine. .env is gitignored; this template is
# committed. The defaults below match the local dev services in
# docker-compose.yml. The backend loads these via pydantic-settings; unset keys
# fall back to the development defaults baked into the settings.

# Deployment environment and log verbosity. `development` renders console logs;
# anything else renders JSON. Both apps share these.
ENVIRONMENT=development
LOG_LEVEL=info

# Postgres (pgvector). See docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://floresu:floresu@localhost:5432/floresu

# Shared secret gating the internal trust boundary (:8001). The MCP server
# presents this same value on every internal call. Empty means the internal
# boundary denies all callers (fail-closed); set a non-empty value to run the
# agent path locally. Prod injects a real secret.
INTERNAL_API_TOKEN=dev-internal-api-token

# Redis: arq queue, SSE pub/sub, and rate-limit counters.
REDIS_URL=redis://localhost:6379/0

# Agent OAuth 2.1 Authorization Server (external app :8000).
#
# Pinned public URLs every issuer/metadata/endpoint URL is built from (the
# "Site-URL gotcha": the tunnel reaches the origin as http://backend:8000, so a
# request-derived URL would break client issuer/audience validation).
# PUBLIC_BASE_URL is the AS origin and token `iss`; APP_PUBLIC_URL is the SPA that
# renders consent; MCP_PUBLIC_URL is the MCP resource agent access tokens are
# audience-bound to. Dev defaults match the local Vite + MCP dev ports.
PUBLIC_BASE_URL=http://localhost:8000
APP_PUBLIC_URL=http://localhost:5173
MCP_PUBLIC_URL=http://localhost:9000

# The AS RSA signing key. The AS holds the private PEM and publishes only the
# public key via JWKS; OAUTH_KEY_ID is the active `kid`. Leave the path empty in
# development to generate an ephemeral in-memory keypair; outside development a
# missing key fails fast at startup (like the session secret).
OAUTH_PRIVATE_KEY_PATH=
OAUTH_KEY_ID=floresu-oauth-dev

# Agent token lifetimes: short-lived access token (seconds) + long rotating
# refresh (seconds). Defaults: 15 minutes and 30 days.
OAUTH_ACCESS_TTL_SECONDS=900
OAUTH_REFRESH_TTL_SECONDS=2592000

# Stale-client reaper: open Dynamic Client Registration rows would grow unbounded,
# so a periodic sweep reaps clients whose registration is older than the max age
# (cascade-revoking each reaped client's grant + refresh chain). A non-positive
# interval disables the in-process sweep (e.g. when reaped out of band).
OAUTH_CLIENT_CLEANUP_INTERVAL_SECONDS=21600
OAUTH_STALE_CLIENT_MAX_AGE_SECONDS=2592000

# MCP resource server (:9000). Validates agent bearer tokens (iss=PUBLIC_BASE_URL,
# aud=MCP_PUBLIC_URL, scope floresu:full) and forwards tool calls to the internal
# app, presenting INTERNAL_API_TOKEN + the resolved X-User-ID/X-Actor (never the
# agent bearer). BACKEND_INTERNAL_URL is the app-net address of the internal app.
BACKEND_INTERNAL_URL=http://localhost:8001

# Rate limiter (Redis, per user): a fixed window with an overall request budget
# and a tighter budget for content writes that trigger embedding. Caps a runaway
# agent's cost/DB load; a trip returns a recoverable slow-down error.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUEST_BUDGET=120
RATE_LIMIT_EMBED_WRITE_BUDGET=30

# Comma-separated proxy IPs/CIDRs the MCP app trusts for X-Forwarded-* (the
# pinned app-net subnet). Empty in dev, so the request scheme is left untouched.
MCP_TRUSTED_PROXIES=

# Embedding provider (the only external AI dependency). The synchronous fast-path
# (internal app) and the arq worker both call OpenAI to embed changed items with
# `text-embedding-3-small` (1536-dim, pinned at migration time). Empty key lets a
# dev/test box boot without an OpenAI account: the fast-path then fails soft and
# items stay lexically searchable. OPENAI_BASE_URL is overridable for a proxy or
# a local stub.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# Embedding worker: drains the arq embed queue on REDIS_URL and calls the internal
# app (BACKEND_INTERNAL_URL + INTERNAL_API_TOKEN) to read items and write vectors
# back. WORKER_METRICS_PORT exposes its Prometheus metrics for scraping; a
# non-positive value disables the exposition server.
WORKER_METRICS_PORT=9100

# Cloudflare R2 object storage for rendered resume PDFs. R2 is S3-compatible:
# R2_ENDPOINT_URL is the account endpoint
# (https://<account>.r2.cloudflarestorage.com) and the key id/secret authenticate
# the S3 API. Empty by default so a dev/test box needs no bucket: the live editor
# preview still renders and streams bytes without one. Export, finalize, and
# revision history are the paths that persist and re-read stored objects, so they
# need real credentials (the E2E stack substitutes MinIO). The presigned-URL
# lifetime is not an environment knob; it is pinned in
# backend/src/floresu/storage/config.py.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Frontend build-time variables (VITE_*), listed here for discoverability only.
# Vite reads env files from frontend/, not from this repo-root file, and inlines
# these into the bundle at build time rather than reading them at runtime, so
# setting them here has no effect. Set them in frontend/.env* for a host inner
# loop; docker-compose.yml and the CD workflow pass the first two as image build
# arguments derived from PUBLIC_BASE_URL and MCP_PUBLIC_URL above.
#
#   VITE_API_BASE_URL  The API origin the SPA calls. Unset means same-origin,
#                      which the Vite dev proxy and the MSW mock harness rely on.
#   VITE_MCP_URL       The MCP endpoint shown on the onboarding connect-agent
#                      step. Unset falls back to the production endpoint in
#                      frontend/src/lib/mcpUrl.ts, so a local dev box shows a
#                      production URL there. That is the default, not a defect.
#   VITE_MOCK_API      "true" starts the MSW mock worker before rendering; the
#                      frontend's dev:mock script sets it.
