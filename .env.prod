# =============================================================================
# Floresu production config (COMMITTED, non-secret only).
#
# The version-controlled, non-secret half of the production environment. The
# deploy (cd.yml) sources it in the CI runner alongside the GitHub Actions
# secrets, then hands the combined environment to the Compose CLI over a Docker
# Context. The VPS holds NO .env: every value the containers read arrives from
# here (committed) or a GitHub secret.
#
# NEVER put a secret in this file. Secrets live only in GitHub Actions:
#   POSTGRES_PASSWORD, REDIS_PASSWORD, SESSION_JWT_SECRET, INTERNAL_API_TOKEN,
#   DISCORD_WEBHOOK_URL, GF_SECURITY_ADMIN_PASSWORD, OPENAI_API_KEY,
#   FLORESU_OAUTH_PRIVATE_KEY, FLORESU_CLOUDFLARED_CREDENTIALS,
#   R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY.
# DATABASE_URL is assembled from POSTGRES_* in the compose environment: block, so
# only the password is a secret.
#
# The local dev inner loop uses the gitignored .env (see .env.example), NOT this
# file. This file is box/CI-only.
#
# >>> GO-LIVE: replace every value marked "REQUIRED: set real value" below. <<<
# =============================================================================

# --- Runtime / logging ------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=info
HOST=0.0.0.0

# --- Pinned public URLs (the "Site-URL gotcha") -----------------------------
# Every OAuth issuer/metadata/endpoint + PRM URL is built from these, never the
# request host (the tunnel reaches the origin as plaintext http://backend:8000).
# REQUIRED: set to your real domains (host-split: SPA vs API vs MCP).
PUBLIC_BASE_URL=https://api.floresu.com
APP_PUBLIC_URL=https://floresu.com
MCP_PUBLIC_URL=https://mcp.floresu.com

# --- Cookies / CORS ---------------------------------------------------------
# The apex Domain so the SPA (floresu.com) and API (api.floresu.com) share the
# session cookie; CORS_ORIGIN pins the SPA origin for credentialed XHRs.
COOKIE_DOMAIN=.floresu.com
CORS_ORIGIN=https://floresu.com

# --- Cloudflare tunnel (non-secret; used to render the ingress in CI) -------
# CF_TUNNEL_ID is the named-tunnel UUID from tunnel bring-up. It is NOT a secret
# (the credentials.json is), so it is committed here.
# REQUIRED: set the real UUID before the first deploy, or the rendered ingress
# points at no tunnel and cloudflared fails to start.
CF_TUNNEL_ID=00000000-0000-0000-0000-000000000000
CF_APP_HOSTNAME=floresu.com
CF_API_HOSTNAME=api.floresu.com
CF_MCP_HOSTNAME=mcp.floresu.com

# --- Agent OAuth 2.1 Authorization Server -----------------------------------
# The signing key itself is the FLORESU_OAUTH_PRIVATE_KEY GitHub secret,
# materialized by Compose as a 0400 file at the path below inside the backend
# container (docker-compose.tunnel.yml).
OAUTH_PRIVATE_KEY_PATH=/run/secrets/oauth_private_key
OAUTH_KEY_ID=floresu-oauth-1
OAUTH_ACCESS_TTL_SECONDS=900
OAUTH_REFRESH_TTL_SECONDS=2592000

# --- Database (non-secret half; POSTGRES_PASSWORD is a GH secret) -----------
POSTGRES_USER=floresu
POSTGRES_DB=floresu
BACKEND_INTERNAL_URL=http://backend:8001

# --- Embedding provider (OPENAI_API_KEY is a GH secret) ---------------------
# The base URL is committed (non-secret); the key is injected at deploy.
OPENAI_BASE_URL=https://api.openai.com

# --- R2 object storage (non-secret half; keys are GH secrets) ---------------
# Rendered PDFs (export, finalize, published-version viewing) persist to
# Cloudflare R2 (S3-compatible). The account endpoint URL and bucket are
# non-secret config and live here; R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY are
# GitHub secrets injected at deploy. The endpoint is the account endpoint
# (https://<account>.r2.cloudflarestorage.com), NOT a per-bucket URL.
# REQUIRED: set the real account endpoint and bucket before the first deploy.
R2_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=floresu-resumes

# --- Worker -----------------------------------------------------------------
WORKER_METRICS_PORT=9100

# --- MCP port ---------------------------------------------------------------
PORT=9000

# --- Image registry ---------------------------------------------------------
# Owner under which cd.yml pushes ghcr.io/<owner>/floresu/{backend,mcp,worker,
# frontend,grafana} (GITHUB_REPOSITORY_OWNER lowercased). FLORESU_IMAGE_TAG is
# `latest` for a normal deploy; cd.yml overrides it to sha-<prev> on a rollback.
# REQUIRED: set to your GitHub org/user (lowercase).
GHCR_OWNER=floresu-platform
FLORESU_IMAGE_TAG=latest

# --- Networking -------------------------------------------------------------
# Subnet app-net is pinned to at deploy (tunnel overlay); compose passes this
# CIDR to the mcp service as the trusted proxy range (MCP_TRUSTED_PROXIES) so it
# honors cloudflared's X-Forwarded-Proto behind the tunnel. Outside Docker's
# default auto pool so it never overlaps an auto-assigned sibling network.
APP_NET_SUBNET=10.89.0.0/24
