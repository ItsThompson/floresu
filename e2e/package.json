{
  "name": "floresu-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright full-stack end-to-end suite for Floresu.",
  "scripts": {
    "infra:up": "tsx harness/infra.ts up",
    "infra:down": "tsx harness/infra.ts down",
    "test": "tsx harness/infra.ts up && playwright test",
    "test:only": "playwright test",
    "test:headed": "tsx harness/infra.ts up && playwright test --headed",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
